              "name": "List sample emails without authentication",
              "id": "40914897-630a-4ea8-a9aa-369d63196531",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/demo/emails",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "demo",
                    "emails"
                  ]
                },

                    }
                  ],
                  "cookie": [],
                  "responseTime": null,
                  "body": "{\n  \"success\": \"<boolean>\",\n  \"data\": {\n    \"id\": \"<uuid>\",\n    \"message_count\": \"<integer>\",\n    \"created_at\": \"<dateTime>\",\n    \"messages\": [\n      {\n        \"direction\": \"inbound\",\n        \"id\": \"<uuid>\",\n        \"message_id\": \"<string,null>\",\n        \"from\": \"<string,null>\",\n        \"to\": \"<string,null>\",\n        \"subject\": \"<string,null>\",\n        \"status\": \"<string,null>\",\n        \"timestamp\": \"<string,null-date-time>\"\n      },\n      {\n        \"direction\": \"outbound\",\n        \"id\": \"<uuid>\",\n        \"message_id\": \"<string,null>\",\n        \"from\": \"<string,null>\",\n        \"to\": \"<string,null>\",\n        \"subject\": \"<string,null>\",\n        \"status\": \"<string,null>\",\n        \"timestamp\": \"<string,null-date-time>\"\n      }\n    ],\n    \"subject\": \"<string,null>\",\n    \"root_message_id\": \"<string,null>\",\n    \"first_message_at\": \"<string,null-date-time>\",\n    \"last_message_at\": \"<string,null-date-time>\"\n  }\n}",

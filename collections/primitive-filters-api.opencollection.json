{
  "opencollection": "1.0.0",
  "info": {
    "name": "Primitive Account Filters API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Filters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List filter rules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.primitive.dev/v1/filters",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns all whitelist and blocklist filter rules."
        },
        {
          "info": {
            "name": "Create a filter rule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.primitive.dev/v1/filters",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new whitelist or blocklist filter. Per-domain filters\nrequire a Pro plan. Patterns are stored as lowercase.\n"
        },
        {
          "info": {
            "name": "Update a filter rule",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.primitive.dev/v1/filters/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Resource UUID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Toggle a filter's enabled state."
        },
        {
          "info": {
            "name": "Delete a filter rule",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.primitive.dev/v1/filters/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Resource UUID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete an inbound routing filter rule. Messages already processed by the rule are unaffected."
        }
      ]
    }
  ],
  "bundled": true
}